  - m_Id: 26437426164707349
    m_Localized: Jugar
    m_Metadata:
      m_Items: []
  - m_Id: 26437426164707350
    m_Localized: "Pr\xF3ximamente..."
    m_Metadata:
      m_Items: []
  - m_Id: 26437426164707351
    m_Localized: "C\xF3mo jugar"
    m_Metadata:
      m_Items: []
  - m_Id: 26437426164707352
    m_Localized: "Selecciona un juego para ver su descripci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 26437426164707353
    m_Localized: Selecciona un juego para ver su tutorial.
    m_Metadata:
      m_Items: []
  - m_Id: 26437426164707354
    m_Localized: "Utiliza el pensamiento abstracto para descifrar los c\xF3digos
      de los ingredientes y trabaja con tu equipo para completar tantos pedidos como
      podais."
    m_Metadata:
      m_Items: []
  - m_Id: 26437426164707355
    m_Localized: Mire las hamburguesas de ejemplo para decodificar los ingredientes,
      luego complete y entregue tantas hamburguesas en la ventanilla de servicio.
    m_Metadata:
      m_Items: []
  - m_Id: 26437426164707356
