    m_Metadata:
      m_Items: []
  - m_Id: 26437426164707332
    m_Localized: "Introduzca el c\xF3digo de clase..."
    m_Metadata:
      m_Items: []
  - m_Id: 26437426164707333
    m_Localized: Siguiente
    m_Metadata:
      m_Items: []
  - m_Id: 26437426164707334
    m_Localized: Edad
    m_Metadata:
      m_Items: []
  - m_Id: 26437426164707335
    m_Localized: Rol
    m_Metadata:
      m_Items: []
  - m_Id: 26437426164707336
    m_Localized: "G\xE9nero"
    m_Metadata:
      m_Items: []
  - m_Id: 26437426164707337
    m_Localized: Por favor, seleccione un rol.
    m_Metadata:
      m_Items: []
  - m_Id: 26437426164707338
    m_Localized: "Por favor, seleccione un g\xE9nero"
    m_Metadata:
      m_Items: []
  - m_Id: 26437426164707339
    m_Localized: Por favor, rellene ambos campos.
    m_Metadata:
      m_Items: []
  - m_Id: 26437426164707340
    m_Localized: "Este nombre de usuario ya est\xE1 en uso."
    m_Metadata:
      m_Items: []
  - m_Id: 26437426164707341
    m_Localized: Este nombre de usuario no existe.
    m_Metadata:
      m_Items: []
  - m_Id: 26437426164707342
    m_Localized: "Error de conexi\xF3n, compruebe su conexi\xF3n a Internet."
    m_Metadata:
      m_Items: []
  - m_Id: 26437426164707343
    m_Localized: Por favor, rellene todos los campos.
    m_Metadata:
      m_Items: []
  - m_Id: 26437426164707344
    m_Localized: "C\xF3digo"
    m_Metadata:
      m_Items: []
  - m_Id: 26437426164707345
    m_Localized: "C\xF3digo de sala:"
    m_Metadata:
      m_Items: []
  - m_Id: 26437426164707346
