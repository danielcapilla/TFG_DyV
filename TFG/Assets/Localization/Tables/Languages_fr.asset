      m_Items: []
  - m_Id: 29751105312796676
    m_Localized: Il n'y a pas de hamburgers...
    m_Metadata:
      m_Items: []
  - m_Id: 29754814444875776
    m_Localized: "Date\_: {fechaVariable} Code\_: {codVariable} "
    m_Metadata:
      m_Items:
      - rid: 2814509147925774343
  - m_Id: 29757728181727232
    m_Localized: Groupes
    m_Metadata:
      m_Items: []
  - m_Id: 29759331483791360
    m_Localized: 'Jeux: {gameVariable}'
    m_Metadata:
      m_Items:
      - rid: 2814509147925774343
  - m_Id: 203949349432078336
    m_Localized: En attente...
    m_Metadata:
      m_Items: []
  - m_Id: 203954884520849408
    m_Localized: "Supermarch\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 203954884554403840
    m_Localized: "Utilisez la pens\xE9e algorithmique pour planifier vos mouvements
      et collaborez avec votre \xE9quipe pour atteindre la ligne d\u2019arriv\xE9e
      avant tout le monde."
    m_Metadata:
      m_Items: []
  - m_Id: 203954884554403841
    m_Localized: "Coordonnez-vous avec votre \xE9quipe pour planifier le meilleur
      itin\xE9raire jusqu'\xE0 la caisse."
    m_Metadata:
      m_Items: []
  - m_Id: 205444540093575168
    m_Localized: Joueur
    m_Metadata:
      m_Items: []
  - m_Id: 205444540139712512
    m_Localized: Sortie
    m_Metadata:
      m_Items: []
  - m_Id: 205444540139712513
    m_Localized: "M\xE9ta"
    m_Metadata:
      m_Items: []
  - m_Id: 205444540139712514
    m_Localized: Obstacle
    m_Metadata:
      m_Items: []
  - m_Id: 205444540139712515
    m_Localized: Vide
    m_Metadata:
      m_Items: []
  - m_Id: 208663472372199424
    m_Localized: "Bienvenue dans le didacticiel du mini-jeu du supermarch\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 208663472372199425
    m_Localized: "Maintenant, votre lecteur est un panier d\u2019achat."
    m_Metadata:
      m_Items: []
  - m_Id: 208663472372199426
    m_Localized: "D\xE9placez-le \xE0 l'aide des fl\xE8ches sur le panneau de droite."
    m_Metadata:
      m_Items: []
  - m_Id: 208663472372199427
    m_Localized: "Pour avoir une meilleure vue du magasin, cliquez sur le bouton
      avec l'ic\xF4ne en forme d'\u0153il."
    m_Metadata:
      m_Items: []
  - m_Id: 208663472372199428
    m_Localized: "Votre objectif principal est d\u2019atteindre la caisse."
    m_Metadata:
      m_Items: []
  - m_Id: 208663472372199429
    m_Localized: Vous le verrez clignoter en vert.
    m_Metadata:
      m_Items: []
  - m_Id: 208663472372199430
    m_Localized: "Super ! Vous avez atteint la page de paiement. Vous allez maintenant
      apprendre \xE0 jouer en groupe.\n\n"
    m_Metadata:
      m_Items: []
  - m_Id: 210129611858128896
    m_Localized: "Bienvenue dans ce deuxi\xE8me tutoriel ! Vous y apprendrez \xE0
      jouer en \xE9quipe."
    m_Metadata:
      m_Items: []
  - m_Id: 210129611900071936
    m_Localized: "Chaque joueur de l'\xE9quipe ajoute un mouvement par tour. Vos
      co\xE9quipiers ajoutent le leur automatiquement.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 210129611900071937
    m_Localized: "Cette fois, vous serez le dernier \xE0 ajouter un mouvement pour
      compl\xE9ter la s\xE9quence."
    m_Metadata:
      m_Items: []
  - m_Id: 210129611900071938
    m_Localized: "Lorsque tous les mouvements sont pr\xEAts, ils seront ex\xE9cut\xE9s
      les uns apr\xE8s les autres."
    m_Metadata:
      m_Items: []
  - m_Id: 210129611908460544
    m_Localized: "Si votre temps de jeu est \xE9coul\xE9, les coups seront ex\xE9cut\xE9s
      automatiquement. D\xE9cidez avant la fin du temps !"
    m_Metadata:
      m_Items: []
  - m_Id: 210129611908460545
    m_Localized: "Il y a maintenant des obstacles dans la boutique. Si vous en percutez
      un, tous vos d\xE9placements du tour seront annul\xE9s. \xC9vitez les collisions
      pour que votre \xE9quipe continue d'avancer!"
    m_Metadata:
      m_Items: []
  - m_Id: 210130967104860160
    m_Localized: "Parfait ! Vous savez maintenant collaborer avec vos co\xE9quipiers.
      Atteignez l'objectif pour terminer."
    m_Metadata:
      m_Items: []
  - m_Id: 210203429599457280
    m_Localized: "Bravo ! Vous avez termin\xE9 le tutoriel."
    m_Metadata:
      m_Items: []
  - m_Id: 215178943523205120
    m_Localized: OPTIONS NIVEAU
    m_Metadata:
      m_Items: []
  - m_Id: 215178943573536768
    m_Localized: Largeur
    m_Metadata:
      m_Items: []
  - m_Id: 215178943573536769
    m_Localized: Hauteur
    m_Metadata:
      m_Items: []
  - m_Id: 215178943573536770
    m_Localized: 'Distance Minimale

'
    m_Metadata:
      m_Items: []
  - m_Id: 215178943573536771
    m_Localized: Obstacles
    m_Metadata:
      m_Items: []
  - m_Id: 215179407895572480
    m_Localized: "D\xE9clenchement"
    m_Metadata:
      m_Items: []
  - m_Id: 290919010234523648
    m_Localized: Tuyaux
    m_Metadata:
      m_Items: []
  - m_Id: 290919010247106560
    m_Localized: "Utilisez la pens\xE9e informatique pour connecter les tuyaux et
      travaillez en \xE9quipe pour terminer autant de niveaux que possible."
    m_Metadata:
      m_Items: []
  - m_Id: 290919010247106561
    m_Localized: "Collectez, faites pivoter et placez les tuiles pour relier les
      deux points. Les tuiles violettes ne peuvent pas \xEAtre modifi\xE9es. Une
      fois le circuit termin\xE9, appuyez sur le bouton bleu pour v\xE9rifier son
      bon fonctionnement."
    m_Metadata:
      m_Items: []
