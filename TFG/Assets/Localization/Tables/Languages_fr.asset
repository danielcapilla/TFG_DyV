  - m_Id: 26437426164707351
    m_Localized: Comment jouer
    m_Metadata:
      m_Items: []
  - m_Id: 26437426164707352
    m_Localized: "S\xE9lectionnez un jeu pour afficher sa description"
    m_Metadata:
      m_Items: []
  - m_Id: 26437426164707353
    m_Localized: "S\xE9lectionnez un jeu pour afficher son tutoriel."
    m_Metadata:
      m_Items: []
  - m_Id: 26437426164707354
    m_Localized: "Utilisez la pens\xE9e abstraite pour d\xE9crypter les ingr\xE9dients
      et travaillez en \xE9quipe pour honorer un maximum de commandes."
    m_Metadata:
      m_Items: []
  - m_Id: 26437426164707355
    m_Localized: "Consultez les exemples de burgers pour d\xE9crypter les ingr\xE9dients,
      puis pr\xE9parez-en et apportez-en autant que possible au guichet."
    m_Metadata:
      m_Items: []
  - m_Id: 26437426164707356
    m_Localized: "\xC9quipes"
    m_Metadata:
      m_Items: []
  - m_Id: 26437426164707357
